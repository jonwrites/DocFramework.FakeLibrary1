{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",

  "metadata": [
    {
      "src": [
        {
          "src": "../artifacts",
          "files": [
            "MyLibrary.dll",
            "MyOtherLibrary.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],

  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ]
      }
    ],

    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],

    "output": "_site",

    "template": [
      "default",
      "modern"
    ],

    "globalMetadata": {
      "_appName": "DLL/XML Documentation Test",
      "_appTitle": "DLL/XML Documentation Test",
      "_enableSearch": true,
      "pdf": true
    }
  }
}